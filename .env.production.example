# Production Environment Configuration
# Скопируйте этот файл в .env и заполните своими значениями

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=game_planner
POSTGRES_USER=gameplanneruser
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ============================================
# Backend Configuration
# ============================================
# Генерируйте JWT_SECRET командой: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_RANDOM_256_BIT_KEY
JWT_EXPIRATION=86400000

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/game_planner

# ============================================
# CORS Configuration
# ============================================
# ВАЖНО: Укажите ВСЕ домены, с которых будет доступно приложение
# Разделяйте запятыми БЕЗ пробелов!
# Примеры:
# - Один домен: https://game-planner.example.com
# - С www: https://game-planner.example.com,https://www.game-planner.example.com
# - Несколько доменов: https://app1.com,https://app2.com,https://api.example.com

CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================
# Domain Configuration (для Caddy)
# ============================================
# Ваш основной домен (без https://)
DOMAIN=your-domain.com

# ============================================
# Ports (обычно не нужно менять)
# ============================================
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ============================================
# Telegram Bot Configuration (опционально)
# ============================================
# Включить уведомления в Telegram при создании новых игр
TELEGRAM_BOT_ENABLED=false
# Токен бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=
# ID чата или канала для отправки уведомлений
# Для получения ID чата: отправьте сообщение боту и используйте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_CHAT_ID=
# ID топика в супергруппе (опционально, только для групп с топиками)
# Для получения Thread ID: отправьте сообщение в топик и найдите message_thread_id в getUpdates
TELEGRAM_BOT_THREAD_ID=
# Часовой пояс для отображения времени в уведомлениях
# Примеры: Europe/Moscow, Europe/Kaliningrad, Europe/Samara, Asia/Yekaterinburg, 
#          Asia/Omsk, Asia/Krasnoyarsk, Asia/Irkutsk, Asia/Yakutsk, 
#          Asia/Vladivostok, Asia/Magadan, Asia/Kamchatka
# Полный список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TELEGRAM_BOT_TIMEZONE=Europe/Moscow
# URL фронтенда для ссылок в уведомлениях
FRONTEND_URL=https://your-domain.com

# ============================================
# Cleanup Configuration
# ============================================
CLEANUP_ENABLED=true
CLEANUP_RETENTION_DAYS=15
CLEANUP_CRON=0 0 3 * * ?

# ============================================
# Checklist перед запуском:
# ============================================
# [ ] JWT_SECRET изменен на случайное значение
# [ ] POSTGRES_PASSWORD изменен на сильный пароль
# [ ] CORS_ALLOWED_ORIGINS содержит ваши production домены
# [ ] DOMAIN указывает на ваш домен
# [ ] DNS настроен и указывает на ваш сервер
# [ ] Порты 80 и 443 открыты в firewall
# [ ] (Опционально) Telegram бот настроен, если нужны уведомления
