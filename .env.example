# Database
POSTGRES_DB=game_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
JWT_SECRET=your-secret-key-change-this-in-production-min-256-bits
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/game_planner

# CORS (разделенные запятой, без пробелов)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Ports (для внешнего Caddy можно изменить на другие)
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Domain (for production with Caddy)
DOMAIN=localhost

# Cleanup Configuration
# Включить/выключить автоматическую очистку устаревших данных
CLEANUP_ENABLED=true
# Количество дней для хранения старых данных (игры и временные слоты)
CLEANUP_RETENTION_DAYS=15
# Cron выражение для запуска очистки (по умолчанию каждый день в 3:00 утра)
# Формат: секунды минуты часы день месяц день_недели
CLEANUP_CRON=0 0 3 * * ?

# Telegram Bot Configuration
# Включить/выключить уведомления в Telegram
TELEGRAM_BOT_ENABLED=false
# Токен бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=
# ID чата или канала для отправки уведомлений
TELEGRAM_BOT_CHAT_ID=
# ID топика в супергруппе (опционально, только для групп с топиками)
TELEGRAM_BOT_THREAD_ID=
# Часовой пояс для отображения времени в уведомлениях
# Примеры: Europe/Moscow, Europe/Kaliningrad, Asia/Yekaterinburg, Asia/Vladivostok
TELEGRAM_BOT_TIMEZONE=Europe/Moscow
# URL фронтенда для ссылок в уведомлениях
FRONTEND_URL=http://localhost:5173
