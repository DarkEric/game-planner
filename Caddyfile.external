# Конфигурация для внешнего Caddy
# Добавьте этот блок в ваш существующий Caddyfile

# ВАЖНО: Замените порты 8080 и 3000 на значения из вашего .env файла
# если вы изменили BACKEND_PORT или FRONTEND_PORT

# Для локальной разработки
game-planner.localhost {
    # Проксирование всех API запросов на бэкенд (включая Swagger UI и OpenAPI)
    handle /api/* {
        reverse_proxy localhost:8080  # Используйте значение BACKEND_PORT из .env
    }

    # Статические файлы фронтенда
    handle {
        reverse_proxy localhost:3000  # Используйте значение FRONTEND_PORT из .env
    }

    log {
        output stdout
        format console
    }
}

