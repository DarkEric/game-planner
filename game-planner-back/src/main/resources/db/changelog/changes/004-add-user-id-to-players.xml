<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-add-user-id-to-players" author="system">
        <addColumn tableName="players">
            <column name="user_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <!-- Удаляем старые записи без пользователя (если есть) или создаем дефолтного пользователя -->
        <sql>
            DELETE FROM players WHERE user_id IS NULL;
        </sql>
        
        <addForeignKeyConstraint
                baseTableName="players"
                baseColumnNames="user_id"
                constraintName="fk_player_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
        
        <!-- Делаем user_id обязательным для новых записей -->
        <addNotNullConstraint tableName="players" columnName="user_id" columnDataType="BIGINT"/>
    </changeSet>

</databaseChangeLog>

