<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="012-create-campaign-invites" author="system">
        <createTable tableName="campaign_invites">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="campaign_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="invited_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="responded_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="campaign_invites"
                baseColumnNames="campaign_id"
                constraintName="fk_campaign_invites_campaign"
                referencedTableName="campaigns"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="campaign_invites"
                baseColumnNames="invited_user_id"
                constraintName="fk_campaign_invites_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="campaign_invites" indexName="idx_campaign_invites_user_status">
            <column name="invited_user_id"/>
            <column name="status"/>
        </createIndex>

        <createIndex tableName="campaign_invites" indexName="idx_campaign_invites_campaign">
            <column name="campaign_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
