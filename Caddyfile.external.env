Конфигурация для внешнего Caddy с использованием переменных окружения

Использование:
1. Экспортируйте переменные:
   export BACKEND_PORT=8080
   export FRONTEND_PORT=3000
2. Запустите Caddy с --envfile или используйте systemd Environment
#
Или используйте Caddy с адаптером для чтения .env файла

Для локальной разработки
game-planner.localhost {
    Проксирование API запросов на бэкенд
    handle /api/* {
        reverse_proxy localhost:{$BACKEND_PORT:8080}
    }

    Статические файлы фронтенда
    handle {
        reverse_proxy localhost:{$FRONTEND_PORT:3000}
    }

    log {
        output stdout
        format console
    }
}

Для production
{$DOMAIN:game-planner.example.com} {
    handle /api/* {
        reverse_proxy localhost:23991 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy localhost:23990
    }

    log {
        output file /var/log/caddy/game-planner.log
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    encode gzip zstd
}
